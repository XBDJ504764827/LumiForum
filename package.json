{
  "name": "lumiforum",
  "version": "0.0.0",
  "private": true,
  "description": "LumiForum — modern, game-agnostic community forum monorepo",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=@lumiforum/web",
    "dev:web": "dotenv -e .env -- pnpm --filter @lumiforum/web dev",
    "dev:api": "dotenv -e .env -- cargo run -p lumiforum-api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@lumiforum/web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --all-targets --locked",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}

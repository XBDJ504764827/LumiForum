# Copy to <DEPLOY_PATH>/env/web.env and chmod 600.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
API_INTERNAL_URL=http://127.0.0.1:8080

# Keep server-rendered metadata and ISR consistent with build-time values.
# Browser bundles still require a rebuild when NEXT_PUBLIC_* values change.
NEXT_PUBLIC_SITE_URL=https://forum.example.com
NEXT_PUBLIC_SITE_NAME=LumiForum
NEXT_PUBLIC_SITE_DESCRIPTION="Community forum"

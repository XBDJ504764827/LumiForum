# Copy to <DEPLOY_PATH>/env/api.env and chmod 600.
APP_ENV=production
HOST=127.0.0.1
PORT=8080
RUST_LOG=info,tower_http=info,sqlx=warn

DATABASE_URL=postgres://lumiforum:CHANGE_ME@127.0.0.1:5432/lumiforum
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=864000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=true
# Keep empty for a host-only cookie on chatapi.cngokz.com.
COOKIE_DOMAIN=
AUTHORIZATION_CACHE_TTL_SECONDS=30
CORS_ORIGIN=https://forum.example.com

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/home/lumiforum/lumiforum/uploads
STORAGE_PUBLIC_URL=https://api.example.com/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_SECS=30
WS_IDLE_TIMEOUT_SECS=90
PRESENCE_TTL_SECS=60
WS_CONNECT_RATE_LIMIT=30

# Optional Steam OpenID settings:
# STEAM_API_KEY=CHANGE_ME
# STEAM_OPENID_REALM=https://chatapi.cngokz.com
# STEAM_RETURN_URL=https://chatapi.cngokz.com/auth/steam/callback
# STEAM_WEB_ORIGIN=https://chat.cngokz.com

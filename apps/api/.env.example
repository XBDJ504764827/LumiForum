# Optional app-local overrides for cargo run outside the root .env flow.
# Prefer the root .env.
# Optional app-local overrides for cargo run outside the root .env flow.
# Prefer the root .env.

APP_ENV=development
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=debug,sqlx=warn
DATABASE_URL=postgres://lumiforum:lumiforum@192.168.0.62:5432/lumiforum
REDIS_URL=redis://:CHANGE_ME@192.168.0.62:6379
JWT_SECRET=dev-only-change-me-in-production
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=864000
REFRESH_TOKEN_TTL_SECONDS=864000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=false
AUTHORIZATION_CACHE_TTL_SECONDS=30
CORS_ORIGIN=http://192.168.0.138:3000
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_PUBLIC_URL=http://192.168.0.138:8080/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_SECS=30
WS_IDLE_TIMEOUT_SECS=90
PRESENCE_TTL_SECS=60
WS_CONNECT_RATE_LIMIT=30
# 部署在反向代理后时设为 true，从 X-Forwarded-For 获取真实客户端 IP（限流/审计依赖它）
TRUST_PROXY=false

# Steam 登录通过 Cloudflare Worker 中继（服务器不直连 Steam）。
# 同时配置以下三项后启用；部署见 scripts/deploy/steam-auth-worker.js。
# STEAM_RELAY_URL=https://cngokz-steam-auth.iquankz.cn
# STEAM_CALLBACK_URL=https://chatapi.cngokz.com/auth/steam/callback
# STEAM_WEB_ORIGIN=https://chat.cngokz.com
# STEAM_HTTP_TIMEOUT_SECONDS=15
# COOKIE_DOMAIN=

# =============================================================================
# LumiForum — local development environment template
# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env
# =============================================================================

# --- Runtime ---
APP_ENV=development
NODE_ENV=development
DEV_HOST=192.168.0.138

# --- PostgreSQL ---
POSTGRES_USER=lumiforum
POSTGRES_PASSWORD=lumiforum
POSTGRES_DB=lumiforum
POSTGRES_PORT=5432
# Used by API (host networking / local cargo run)
DATABASE_URL=postgres://lumiforum:lumiforum@192.168.0.62:5432/lumiforum

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@192.168.0.62:6379

# --- API (Rust / Axum) ---
API_PORT=8080
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=debug,sqlx=warn
JWT_SECRET=dev-only-change-me-in-production
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=false
AUTHORIZATION_CACHE_TTL_SECONDS=30
CORS_ORIGIN=http://192.168.0.138:3000

# --- Web (Next.js) ---
WEB_PORT=3000
# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://192.168.0.138:8080
# Server-side fetch inside Docker network (compose overrides this for web service)
API_INTERNAL_URL=http://192.168.0.138:8080

# --- Object storage (S3 compatible — unused in phase 1) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Docker / tooling ---
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
NEXT_TELEMETRY_DISABLED=1

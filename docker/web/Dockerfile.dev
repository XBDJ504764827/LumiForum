# Development image for apps/web — Next.js hot reload via pnpm
FROM node:20-bookworm-slim

RUN corepack enable \
  && corepack prepare pnpm@9.15.0 --activate \
  && apt-get update \
  && apt-get install -y --no-install-recommends wget ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development

# Store path matches compose volume mount
RUN pnpm config set store-dir /pnpm/store

EXPOSE 3000

# Install workspace deps then run Next dev server
CMD ["sh", "-c", "pnpm install --frozen-lockfile=false && pnpm --filter @lumiforum/web dev"]

# LumiForum production environment template
# On the server:
#   cp .env.production.example .env
#   # edit every CHANGE_ME / example.com value
#   ./scripts/deploy/up.sh
# Never commit the real .env.

# --- Domain / TLS ---
DOMAIN=forum.example.com
CERTBOT_EMAIL=ops@example.com

# --- Runtime ---
APP_ENV=production
NODE_ENV=production
RUST_LOG=info,tower_http=info,sqlx=warn

# --- PostgreSQL ---
POSTGRES_USER=lumiforum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lumiforum
# Used by API container via compose interpolation
DATABASE_URL=postgres://lumiforum:CHANGE_ME@postgres:5432/lumiforum

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API security ---
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=true
AUTHORIZATION_CACHE_TTL_SECONDS=30
# Must match the public site origin (scheme + host, no trailing slash)
CORS_ORIGIN=https://forum.example.com

# --- Public URLs (also bake NEXT_PUBLIC_* into the web image at build time) ---
NEXT_PUBLIC_API_URL=https://forum.example.com/api
NEXT_PUBLIC_SITE_URL=https://forum.example.com
NEXT_PUBLIC_SITE_NAME=LumiForum
NEXT_PUBLIC_SITE_DESCRIPTION=现代化社区论坛 — 讨论、分享与协作
API_INTERNAL_URL=http://api:8080

# --- Object storage ---
# Prefer S3/R2 in production. local keeps files in the uploads_data volume.
STORAGE_PROVIDER=s3
STORAGE_LOCAL_ROOT=/data/uploads
STORAGE_PUBLIC_URL=https://cdn.example.com
S3_ENDPOINT=https://CHANGE_ME
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.example.com

# --- Realtime ---
WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_SECS=30
WS_IDLE_TIMEOUT_SECS=90
PRESENCE_TTL_SECS=60
WS_CONNECT_RATE_LIMIT=30

# --- Images (set by CI deploy; override for manual rollbacks) ---
# IMAGE_API=ghcr.io/your-org/lumiforum-api:sha-...
# IMAGE_WEB=ghcr.io/your-org/lumiforum-web:sha-...

# --- Backups ---
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 3 * * *

# --- Monitoring profile (optional) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=https://forum.example.com/grafana/

NEXT_TELEMETRY_DISABLED=1

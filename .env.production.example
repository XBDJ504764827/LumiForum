# LumiForum production environment template
#
# Copy to the build machine as .env (gitignored). It provides build-time
# NEXT_PUBLIC_* values. Create separate api.env and web.env files manually on
# the production server. Never commit or upload the combined real .env.
#
# Assumes the server already has PostgreSQL, Redis, and a reverse proxy
# (e.g. 1Panel) that forwards:
#   https://<forum domain>  -> 127.0.0.1:3000   (web)
#   https://<api domain>    -> 127.0.0.1:8080   (api, enable WebSocket in the panel)

# --- Runtime ---
APP_ENV=production
RUST_LOG=info,tower_http=info,sqlx=warn

# --- PostgreSQL (existing host service) ---
POSTGRES_USER=lumiforum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lumiforum
DATABASE_URL=postgres://lumiforum:CHANGE_ME@127.0.0.1:5432/lumiforum

# --- Redis (existing host service) ---
REDIS_URL=redis://127.0.0.1:6379

# --- API bind (customizable) ---
# 127.0.0.1 is fine when the panel proxies from the same host. Use 0.0.0.0
# if the panel's proxy container cannot reach the loopback address.
API_HOST=127.0.0.1
API_PORT=8080

# --- API security ---
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=true
AUTHORIZATION_CACHE_TTL_SECONDS=30
# Must match the public forum origin (scheme + host, no trailing slash)
CORS_ORIGIN=https://forum.example.com

# --- Public URLs (baked into the web bundle at build time) ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://forum.example.com
NEXT_PUBLIC_SITE_NAME=LumiForum
NEXT_PUBLIC_SITE_DESCRIPTION=现代化社区论坛 — 讨论、分享与协作
# Server-side fetch (ISR/RSS) — same host, no public network needed.
API_INTERNAL_URL=http://127.0.0.1:8080

# --- Web bind (customizable) ---
NODE_ENV=production
WEB_HOSTNAME=127.0.0.1
WEB_PORT=3000

# --- Object storage ---
# Prefer S3/R2 in production. For local storage, replace this with an absolute
# persistent path outside release directories, for example
# /home/lumiforum/lumiforum/uploads.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/home/lumiforum/lumiforum/uploads
STORAGE_PUBLIC_URL=https://api.example.com/storage
S3_ENDPOINT=https://CHANGE_ME
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.example.com

# --- Realtime ---
WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_SECS=30
WS_IDLE_TIMEOUT_SECS=90
PRESENCE_TTL_SECS=60
WS_CONNECT_RATE_LIMIT=30

# --- Steam OpenID (optional) ---
# STEAM_API_KEY=CHANGE_ME
# STEAM_OPENID_REALM=https://forum.example.com
# STEAM_RETURN_URL=https://forum.example.com/auth/steam/callback
# STEAM_WEB_ORIGIN=https://forum.example.com

# LumiForum production environment template
# Create a private .env on the production host and replace every CHANGE_ME value.

APP_ENV=production
NODE_ENV=production

POSTGRES_USER=lumiforum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lumiforum
POSTGRES_PORT=5432
DATABASE_URL=postgres://lumiforum:CHANGE_ME@postgres:5432/lumiforum

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

API_PORT=8080
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,tower_http=info,sqlx=warn
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=lumiforum-api
JWT_AUDIENCE=lumiforum-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_CONCURRENCY=4
REFRESH_COOKIE_NAME=lumiforum_refresh
REFRESH_COOKIE_SECURE=true
AUTHORIZATION_CACHE_TTL_SECONDS=30
CORS_ORIGIN=https://forum.example.com

WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.example.com
API_INTERNAL_URL=http://api:8080

S3_ENDPOINT=https://CHANGE_ME
S3_REGION=auto
S3_BUCKET=lumiforum
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false

NEXT_TELEMETRY_DISABLED=1
